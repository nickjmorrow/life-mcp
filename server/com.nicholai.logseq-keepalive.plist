<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The server Mac: the connector needs the Logseq app (its CLI talks to the app's db-worker). Reopen it, hidden, if it isn't running. -->
	<key>Label</key>
	<string>com.nicholai.logseq-keepalive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>pgrep -xq Logseq || /usr/bin/open -g -j -a Logseq</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
